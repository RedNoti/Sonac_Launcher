{
  "name": "sonac_launcher",
  "productName": "sonac launcher",
  "version": "0.1.9",
  "description": "Windows와 macOS용 개인 파일 런처",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac && npm run build:win",
    "build:mac": "node scripts/package.mjs mac arm64",
    "build:win": "node scripts/package.mjs win",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/storage.js && node --check src/sync.js && node --check src/ui/app.js",
    "test": "node --test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fflate": "0.8.3",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.5.438",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.5.1"
  }
}
