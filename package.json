{
  "name": "sonac_launcher",
  "productName": "sonac launcher",
  "version": "0.4.5",
  "description": "Windows와 macOS용 개인 파일 런처",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac && npm run build:win",
    "build:mac": "node scripts/package.mjs mac arm64",
    "build:win": "node scripts/package.mjs win",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/storage.js && node --check src/sync.js && node --check src/ui/app.js",
    "test": "node --test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cfb": "1.2.2",
    "fflate": "0.8.3",
    "firebase": "13.4.0",
    "music-metadata": "12.8.1",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.5.438",
    "saxes": "6.0.0",
    "undici": "8.13.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "electron": "45.4.1",
    "resedit": "3.1.1"
  },
  "releaseVersion": "0.4.5",
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
